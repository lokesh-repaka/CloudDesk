# ==============================================================================
# CloudDesk Support Platform — Environment Configuration Template
# Copy this file to .env and adjust variables as needed for local development.
# Never commit the actual .env file to version control.
# ==============================================================================

# Core Runtime & Environment
DEMO_MODE=true
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# Authentication & Security
# WARNING: Change JWT_SECRET in production. Production will fail to boot if default secret is used.
JWT_SECRET=dev-secret-change-in-prod
SUPABASE_JWT_SECRET=

# Persistence
DATABASE_URL=sqlite+aiosqlite:///./data/support.db
CHECKPOINT_DB_PATH=./data/checkpoints.db

# Cache & Rate Limiting
REDIS_URL=
USE_FAKE_REDIS=true
RATE_LIMIT_PER_MINUTE=120

# LLM Provider Configuration (fake | openai | anthropic | azure | google)
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL=fake-model

# Embeddings & Vector Store Configuration
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=fake-embedding
EMBEDDING_DIMENSIONS=384
VECTOR_STORE=memory
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=clouddesk_knowledge

# Business Rules & Tool Policy
APPROVAL_REQUIRED_FOR_REFUNDS=true
MAX_REFUND_WITHOUT_APPROVAL=0.0
TOOL_TIMEOUT_SECONDS=30
SAMPLE_DATA_DIR=./sample_data

# Observability & Tracing (LangSmith)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=clouddesk-support
